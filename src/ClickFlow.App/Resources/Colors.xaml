<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral ramp (zinc) -->
    <Color x:Key="Color.Canvas">#FF121214</Color>
    <Color x:Key="Color.Surface">#FF19191C</Color>
    <Color x:Key="Color.Raised">#FF212125</Color>
    <Color x:Key="Color.Well">#FF0E0E10</Color>
    <Color x:Key="Color.Hover">#14FFFFFF</Color>
    <Color x:Key="Color.Pressed">#22FFFFFF</Color>
    <Color x:Key="Color.Hairline">#14FFFFFF</Color>
    <Color x:Key="Color.HairlineStrong">#26FFFFFF</Color>
    <Color x:Key="Color.Text">#FFF4F4F5</Color>
    <Color x:Key="Color.TextSecondary">#FFA1A1AA</Color>
    <Color x:Key="Color.TextMuted">#FF71717A</Color>
    <Color x:Key="Color.TextDisabled">#FF52525B</Color>

    <!-- Accent + status -->
    <Color x:Key="Color.Accent">#FF5B9CF5</Color>
    <Color x:Key="Color.AccentHover">#FF74ADF8</Color>
    <Color x:Key="Color.AccentPressed">#FF4A86DC</Color>
    <Color x:Key="Color.AccentSoft">#245B9CF5</Color>
    <Color x:Key="Color.OnAccent">#FF0B1526</Color>
    <Color x:Key="Color.Success">#FF34D399</Color>
    <Color x:Key="Color.Warning">#FFFBBF24</Color>
    <Color x:Key="Color.Danger">#FFF87171</Color>
    <Color x:Key="Color.DangerSoft">#24F87171</Color>
    <Color x:Key="Color.Recording">#FFF43F5E</Color>

    <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Raised" Color="{StaticResource Color.Raised}" />
    <SolidColorBrush x:Key="Brush.Well" Color="{StaticResource Color.Well}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Pressed}" />
    <SolidColorBrush x:Key="Brush.Hairline" Color="{StaticResource Color.Hairline}" />
    <SolidColorBrush x:Key="Brush.HairlineStrong" Color="{StaticResource Color.HairlineStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
    <SolidColorBrush x:Key="Brush.Recording" Color="{StaticResource Color.Recording}" />

    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI, Malgun Gothic, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, monospace</FontFamily>

    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">8</CornerRadius>

</ResourceDictionary>
