<UserControl x:Class="ClickFlow.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClickFlow.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="녹화 시작" Command="{Binding GoToRecorderCommand}" Margin="0,0,8,0" />
                <Button Content="새 매크로" Style="{StaticResource Button.Primary}" Command="{Binding GoToMacrosCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="대시보드" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{Binding Now, StringFormat='{}{0:yyyy-MM-dd (ddd) HH:mm:ss}'}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Stats row: label + value, separated by dividers -->
        <Border Grid.Row="1" Style="{StaticResource Panel.Surface}" Padding="0" Margin="0,0,0,20">
            <UniformGrid Columns="4">
                <StackPanel Margin="20,14">
                    <TextBlock Text="매크로" Style="{StaticResource Text.Label}" />
                    <TextBlock Text="{Binding MacroCount}" Style="{StaticResource Text.Stat}" />
                </StackPanel>
                <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1,0,0,0">
                    <StackPanel Margin="20,14">
                        <TextBlock Text="예약됨" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding ScheduledCount}" Style="{StaticResource Text.Stat}" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1,0,0,0">
                    <StackPanel Margin="20,14">
                        <TextBlock Text="이번 세션 실행" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding RunCount}" Style="{StaticResource Text.Stat}" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1,0,0,0">
                    <StackPanel Margin="20,14">
                        <TextBlock Text="성공" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding SuccessCount}" Style="{StaticResource Text.Stat}" Foreground="{StaticResource Brush.Success}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Current execution / recent -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="현재 실행" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />

                <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Surface}" Margin="0,0,0,20">
                    <Grid>
                        <StackPanel Visibility="{Binding Execution.CurrentMacro, Converter={StaticResource NullToVisible}}">
                            <TextBlock Text="실행 중인 매크로가 없습니다." Foreground="{StaticResource Brush.TextSecondary}" />
                            <TextBlock Text="매크로를 열고 ▶ 실행 버튼을 누르거나 F8을 누르세요." Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Grid Visibility="{Binding Execution.CurrentMacro, Converter={StaticResource NullToCollapsed}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Execution.CurrentMacro.Name}" FontSize="16" FontWeight="Medium" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Execution.State, Converter={StaticResource StateToBrush}}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Execution.State, Converter={StaticResource StateToText}}" Margin="8,0,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Execution.Remaining, Converter={StaticResource Countdown}}" Style="{StaticResource Text.Stat}"
                                       Visibility="{Binding Execution.Remaining, Converter={StaticResource NullToCollapsed}}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="최근 수정" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Recent}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="4,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="편집" Style="{StaticResource Button.Ghost}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <Button Content="실행" Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,2,0,0">
                                            <Run Text="{Binding Profile, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Actions.Count, Mode=OneWay}" /><Run Text="개 동작 · " /><Run Text="{Binding Schedule.Summary, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- Upcoming -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="예약된 실행" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />
                <TextBlock DockPanel.Dock="Top" Text="예약된 매크로가 없습니다." Style="{StaticResource Text.Muted}"
                           Visibility="{Binding ScheduledCount, Converter={StaticResource ZeroToVisible}}" />
                <ItemsControl ItemsSource="{Binding Upcoming}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="4,10">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="대기 시작" Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                        <TextBlock Text="{Binding Schedule.StartTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}" Style="{StaticResource Text.Mono}" FontSize="12" Foreground="{StaticResource Brush.Accent}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
