<Window x:Class="ClickFlow.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClickFlow.App.ViewModels"
        xmlns:views="clr-namespace:ClickFlow.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ClickFlow"
        Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Background="{StaticResource Brush.Canvas}"
        FontFamily="{StaticResource Font.UI}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MacroListViewModel}">
            <views:MacroListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MacroEditorViewModel}">
            <views:MacroEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecorderViewModel}">
            <views:RecorderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExecutionViewModel}">
            <views:ExecutionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,20">
                    <TextBlock Text="ClickFlow" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="개인용 데스크톱 자동화" Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="8,0">
                        <Ellipse Width="8" Height="8" Fill="{Binding Execution.State, Converter={StaticResource StateToBrush}}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <RadioButton Style="{StaticResource Button.Nav}" Content="대시보드" GroupName="Nav"
                                 IsChecked="{Binding CurrentPageKind, Converter={StaticResource EnumEquals}, ConverterParameter=Dashboard, Mode=OneWay}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:PageKind.Dashboard}" />
                    <RadioButton Style="{StaticResource Button.Nav}" Content="내 매크로" GroupName="Nav"
                                 IsChecked="{Binding CurrentPageKind, Converter={StaticResource EnumEquals}, ConverterParameter=Macros, Mode=OneWay}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:PageKind.Macros}" />
                    <RadioButton Style="{StaticResource Button.Nav}" Content="편집기" GroupName="Nav"
                                 IsChecked="{Binding CurrentPageKind, Converter={StaticResource EnumEquals}, ConverterParameter=Editor, Mode=OneWay}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:PageKind.Editor}" />
                    <RadioButton Style="{StaticResource Button.Nav}" Content="레코더" GroupName="Nav"
                                 IsChecked="{Binding CurrentPageKind, Converter={StaticResource EnumEquals}, ConverterParameter=Recorder, Mode=OneWay}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:PageKind.Recorder}" />
                    <RadioButton Style="{StaticResource Button.Nav}" Content="실행" GroupName="Nav"
                                 IsChecked="{Binding CurrentPageKind, Converter={StaticResource EnumEquals}, ConverterParameter=Execution, Mode=OneWay}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:PageKind.Execution}" />
                    <RadioButton Style="{StaticResource Button.Nav}" Content="설정" GroupName="Nav"
                                 IsChecked="{Binding CurrentPageKind, Converter={StaticResource EnumEquals}, ConverterParameter=Settings, Mode=OneWay}"
                                 Command="{Binding NavigateToCommand}" CommandParameter="{x:Static vm:PageKind.Settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Page -->
        <Grid Grid.Row="0" Grid.Column="1">
            <ContentControl Content="{Binding CurrentPage}" Margin="28,24,28,16" />

            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,28,20"
                    Background="{StaticResource Brush.Raised}" BorderBrush="{StaticResource Brush.HairlineStrong}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Panel}" Padding="14,10" MaxWidth="480"
                    Visibility="{Binding ToastMessage, Converter={StaticResource NullToCollapsed}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE711;" Command="{Binding DismissToastCommand}" Margin="8,-4,-6,-4" ToolTip="닫기" />
                    <TextBlock Text="{Binding ToastMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding HotkeyHint}" Style="{StaticResource Text.Muted}" FontSize="12" />
                <TextBlock Text="{Binding Execution.State, Converter={StaticResource StateToText}}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
