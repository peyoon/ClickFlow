<UserControl x:Class="ClickFlow.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClickFlow.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="360" TextWrapping="Wrap" />
                <Button Content="데이터 폴더 열기" Style="{StaticResource Button.Ghost}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                <Button Content="저장" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" MinWidth="88" />
            </StackPanel>
            <TextBlock Text="설정" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">

                <Border Style="{StaticResource Panel.Surface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="핫키" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="전역 핫키입니다. 다른 창이 활성화되어 있어도 동작합니다. 예: F8, Ctrl+Shift+F9" Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,0,0,12" />
                        <UniformGrid Columns="4" Margin="-4,0">
                            <StackPanel Margin="4,0">
                                <TextBlock Text="시작" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding StartHotkey, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Mono}" />
                            </StackPanel>
                            <StackPanel Margin="4,0">
                                <TextBlock Text="일시정지 / 재개" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding PauseHotkey, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Mono}" />
                            </StackPanel>
                            <StackPanel Margin="4,0">
                                <TextBlock Text="중지" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding StopHotkey, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Mono}" />
                            </StackPanel>
                            <StackPanel Margin="4,0">
                                <TextBlock Text="비상 정지" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding PanicHotkey, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Mono}" />
                            </StackPanel>
                        </UniformGrid>
                        <CheckBox Content="마우스를 화면 왼쪽 위 모서리로 옮기면 즉시 정지" IsChecked="{Binding PanicOnCornerMove}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel.Surface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="타이밍" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,12" />
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="고정밀 대기 구간 (ms)" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding HighResolutionWindowMs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Mono}" Width="140" HorizontalAlignment="Left" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="12" TextWrapping="Wrap"
                                   Text="예약 시각까지 남은 시간이 이 값 이하가 되면 스레드 대기 대신 고정밀 타이머로 전환합니다. 값이 클수록 정확하지만 CPU를 더 사용합니다. 재시작 후 적용됩니다." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel.Surface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="폴더" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,12" />
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="매크로 저장 폴더 (재시작 후 적용)" Style="{StaticResource Text.Label}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="찾아보기" Command="{Binding BrowseMacroDirectoryCommand}" Margin="4,0,0,0" />
                                <TextBox Text="{Binding MacroDirectory, UpdateSourceTrigger=LostFocus}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="스크린샷 폴더" Style="{StaticResource Text.Label}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="찾아보기" Command="{Binding BrowseScreenshotDirectoryCommand}" Margin="4,0,0,0" />
                                <TextBox Text="{Binding ScreenshotDirectory, UpdateSourceTrigger=LostFocus}" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel.Surface}">
                    <StackPanel>
                        <TextBlock Text="동작" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,12" />
                        <CheckBox Content="녹화 시 마우스 이동 경로도 기록" IsChecked="{Binding RecordMouseMoves}" Margin="0,0,0,8" />
                        <CheckBox Content="최소화하면 트레이로 보내기" IsChecked="{Binding MinimizeToTray}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
