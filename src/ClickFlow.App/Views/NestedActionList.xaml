<UserControl x:Class="ClickFlow.App.Views.NestedActionList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource Panel.Well}" Margin="0,0,0,12">
        <StackPanel>
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="+ 클릭 추가" Style="{StaticResource Button.Ghost}" Padding="8,2" MinHeight="26"
                        Command="{Binding DataContext.AddChildCommand, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}"
                        CommandParameter="{Binding AddSlot, ElementName=Root}" />
                <TextBlock Text="{Binding Header, ElementName=Root}" Style="{StaticResource Text.Label}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="동작 없음" Style="{StaticResource Text.Muted}" FontSize="12" Visibility="{Binding Items.Count, ElementName=Root, Converter={StaticResource ZeroToVisible}}" />
            <ItemsControl ItemsSource="{Binding Items, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE711;" MinHeight="24" MinWidth="24" Padding="2" FontSize="11" ToolTip="제거"
                                    Command="{Binding DataContext.RemoveChildCommand, RelativeSource={RelativeSource AncestorType=UserControl, AncestorLevel=2}}" CommandParameter="{Binding}" />
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" Width="80" VerticalAlignment="Center" />
                            <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" FontSize="12" MinHeight="26" Padding="6,2" Width="64" Margin="0,0,4,0" Visibility="{Binding IsPointer, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" FontSize="12" MinHeight="26" Padding="6,2" Width="64" Margin="0,0,4,0" Visibility="{Binding IsPointer, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox Text="{Binding Milliseconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" FontSize="12" MinHeight="26" Padding="6,2" Width="80" Visibility="{Binding IsWait, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox Text="{Binding Key, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Mono}" FontSize="12" MinHeight="26" Padding="6,2" Width="80" Visibility="{Binding IsKeyboard, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding DisplayValue}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="중첩 동작의 세부 설정은 JSON 파일에서 편집할 수 있습니다." Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,6,0,0" />
        </StackPanel>
    </Border>
</UserControl>
