<UserControl x:Class="ClickFlow.App.Views.MacroEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClickFlow.App.ViewModels"
             xmlns:views="clr-namespace:ClickFlow.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MacroEditorViewModel}">

    <UserControl.Resources>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                <Button Content="녹화" Style="{StaticResource Button.Ghost}" Command="{Binding RecordCommand}" />
                <Button Content="테스트 실행" Command="{Binding TestRunCommand}" Margin="4,0,0,0" ToolTip="예약을 무시하고 즉시 실행합니다 (F10: 중지)" />
                <Button Content="저장" Command="{Binding SaveCommand}" Margin="4,0,0,0" />
                <Button Content="▶ 실행" Style="{StaticResource Button.Primary}" Command="{Binding RunCommand}" Margin="8,0,0,0" MinWidth="88" />
            </StackPanel>
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Icon}" Content="&#xE72B;" Command="{Binding BackCommand}" ToolTip="매크로 목록" Margin="-6,0,6,0" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Padding="0" MinWidth="320" VerticalAlignment="Center" />
                    <TextBlock Text="●" Foreground="{StaticResource Brush.Warning}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="저장되지 않은 변경"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="30,2,0,0">
                    <TextBlock Text="프로필" Style="{StaticResource Text.Muted}" FontSize="12" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Profile, UpdateSourceTrigger=LostFocus}" FontSize="12" Background="Transparent" BorderThickness="0" Padding="4,0" MinWidth="80" MinHeight="0" VerticalAlignment="Center" />
                    <TextBlock Text="·" Style="{StaticResource Text.Muted}" Margin="4,0" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=LostFocus}" FontSize="12" Background="Transparent" BorderThickness="0" Padding="4,0" MinWidth="240" MinHeight="0" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" ToolTip="설명" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="420" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="3*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: action list -->
            <DockPanel Grid.Column="0">
                <!-- toolbar -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE74A;" ToolTip="위로" Command="{Binding MoveUpCommand}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE74B;" ToolTip="아래로" Command="{Binding MoveDownCommand}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE8C8;" ToolTip="복제" Command="{Binding DuplicateCommand}" />
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE74D;" ToolTip="삭제 (Del)" Command="{Binding RemoveCommand}" Foreground="{StaticResource Brush.Danger}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="동작" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox x:Name="AddKind" ItemsSource="{Binding ActionKinds}" DisplayMemberPath="Label" SelectedIndex="0" Width="140" />
                        <Button Content="+ 추가" Command="{Binding AddActionCommand}" CommandParameter="{Binding SelectedItem, ElementName=AddKind}" Margin="4,0,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- column header -->
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="0,0,0,1" Padding="10,0,10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" Style="{StaticResource Text.Label}" Margin="0" />
                        <TextBlock Grid.Column="2" Text="동작" Style="{StaticResource Text.Label}" Margin="0" />
                        <TextBlock Grid.Column="3" Text="값" Style="{StaticResource Text.Label}" Margin="0" />
                        <TextBlock Grid.Column="4" Text="지연" Style="{StaticResource Text.Label}" Margin="0" />
                    </Grid>
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="동작이 없습니다. 위에서 동작을 추가하거나 [녹화]로 시작하세요." Style="{StaticResource Text.Muted}" Margin="10,12"
                           Visibility="{Binding Actions.Count, Converter={StaticResource ZeroToVisible}}" />

                <ListBox x:Name="ActionList" ItemsSource="{Binding Actions}" SelectedItem="{Binding Selected}" AllowDrop="True"
                         PreviewMouseLeftButtonDown="ActionList_PreviewMouseLeftButtonDown" PreviewMouseMove="ActionList_PreviewMouseMove"
                         Drop="ActionList_Drop" DragOver="ActionList_DragOver">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
                        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateCommand}" />
                        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding MoveUpCommand}" />
                        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding MoveDownCommand}" />
                    </ListBox.InputBindings>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Index, Converter={StaticResource IndexPlusOne}}" Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{StaticResource Brush.Success}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="사용"
                                          Visibility="{Binding IsCurrent, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontWeight="Medium" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding DisplayValue}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Grid.Column="4" Style="{StaticResource Text.Mono}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource DelayText}">
                                            <Binding Path="DelayBeforeMs" />
                                            <Binding Path="DelayAfterMs" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>

            <!-- RIGHT: inspector -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Selected action -->
                    <Border Style="{StaticResource Panel.Surface}" Margin="0,0,0,16" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DataContext="{Binding Selected}">
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Index, Converter={StaticResource IndexPlusOne}, StringFormat='#{0}'}" Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Medium" />
                            </DockPanel>

                            <!-- Pointer -->
                            <StackPanel Visibility="{Binding IsPointer, Converter={StaticResource BoolToVisibility}}">
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="X" Style="{StaticResource Text.Label}" />
                                        <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y" Style="{StaticResource Text.Label}" />
                                        <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                    </StackPanel>
                                    <Button Grid.Column="4" Content="좌표 지정" VerticalAlignment="Bottom"
                                            Command="{Binding DataContext.PickPointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="화면에서 직접 위치를 클릭해 좌표를 가져옵니다" />
                                </Grid>
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Text="좌표 기준" Style="{StaticResource Text.Label}" />
                                    <ComboBox ItemsSource="{Binding DataContext.CoordinateModes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding CoordinateMode}" />
                                </StackPanel>
                                <Grid Style="{StaticResource Row}" Visibility="{Binding HasButton, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="버튼" Style="{StaticResource Text.Label}" />
                                        <ComboBox ItemsSource="{Binding DataContext.MouseButtons, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Button}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Visibility="{Binding IsClick, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="클릭 횟수" Style="{StaticResource Text.Label}" />
                                        <TextBox Text="{Binding ClickCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="클릭 전에 마우스 이동" IsChecked="{Binding MoveBeforeClick}" Margin="0,0,0,12" Visibility="{Binding IsClick, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsMove, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="이동 시간 (ms, 0 = 즉시)" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding DurationMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Scroll -->
                            <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsScroll, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="스크롤 칸 수 (양수 = 위, 음수 = 아래)" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding ScrollNotches, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                            </StackPanel>

                            <!-- Keyboard -->
                            <StackPanel Visibility="{Binding IsKeyboard, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Text="키" Style="{StaticResource Text.Label}" />
                                    <ComboBox IsEditable="True" Text="{Binding Key, UpdateSourceTrigger=LostFocus}" ItemsSource="{Binding DataContext.KeyNames, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <CheckBox Content="Ctrl" IsChecked="{Binding Ctrl}" Margin="0,0,14,0" />
                                    <CheckBox Content="Shift" IsChecked="{Binding Shift}" Margin="0,0,14,0" />
                                    <CheckBox Content="Alt" IsChecked="{Binding Alt}" Margin="0,0,14,0" />
                                    <CheckBox Content="Win" IsChecked="{Binding Win}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Text -->
                            <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Text="입력할 문자열" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Text="글자 간 간격 (ms)" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Wait -->
                            <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsWait, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="대기 시간 (ms)" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding Milliseconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                            </StackPanel>

                            <!-- Screenshot -->
                            <StackPanel Visibility="{Binding IsScreenshot, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Text="파일 이름 (비우면 자동)" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding FileName, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Text="캡처 영역" Style="{StaticResource Text.Label}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="지우기" Style="{StaticResource Button.Ghost}" Command="{Binding DataContext.ClearRegionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <Button DockPanel.Dock="Right" Content="영역 지정" Command="{Binding DataContext.PickRegionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding RegionText}" Style="{StaticResource Text.Mono}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Repeat -->
                            <StackPanel Visibility="{Binding IsRepeat, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Text="반복 횟수 (0 = 중지할 때까지)" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                </StackPanel>
                                <views:NestedActionList Header="반복할 동작" Items="{Binding Children}" AddSlot="then" />
                            </StackPanel>

                            <!-- Stop -->
                            <CheckBox Content="성공으로 종료 (해제 시 실패로 기록)" IsChecked="{Binding StopSuccess}" Margin="0,0,0,12" Visibility="{Binding IsStop, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Condition -->
                            <StackPanel Visibility="{Binding IsCondition, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Text="조건 종류" Style="{StaticResource Text.Label}" />
                                    <ComboBox ItemsSource="{Binding DataContext.ConditionKinds, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding ConditionKind}" />
                                </StackPanel>
                                <CheckBox Content="조건 반전 (NOT)" IsChecked="{Binding Negate}" Margin="0,0,0,12" />

                                <StackPanel Visibility="{Binding IsPixelCondition, Converter={StaticResource BoolToVisibility}}">
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="X" Style="{StaticResource Text.Label}" />
                                            <TextBox Text="{Binding PixelX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Y" Style="{StaticResource Text.Label}" />
                                            <TextBox Text="{Binding PixelY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                        </StackPanel>
                                        <Button Grid.Column="4" Content="픽셀 선택" VerticalAlignment="Bottom" Command="{Binding DataContext.PickPixelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="화면을 클릭해 좌표와 색상을 함께 가져옵니다" />
                                    </Grid>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="색상 (#RRGGBB)" Style="{StaticResource Text.Label}" />
                                            <TextBox Text="{Binding PixelColorHex, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Mono}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="허용 오차 (0–255)" Style="{StaticResource Text.Label}" />
                                            <TextBox Text="{Binding Tolerance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsImageCondition, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Style="{StaticResource Field}">
                                        <TextBlock Text="찾을 이미지" Style="{StaticResource Text.Label}" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="찾아보기" Style="{StaticResource Button.Ghost}" Command="{Binding DataContext.BrowseImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <Button DockPanel.Dock="Right" Content="화면에서 캡처" Command="{Binding DataContext.CaptureTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,4,0" />
                                            <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=LostFocus}" Margin="0,0,4,0" />
                                        </DockPanel>
                                    </StackPanel>
                                    <Grid Style="{StaticResource Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="유사도 (0.1–1.0)" Style="{StaticResource Text.Label}" />
                                            <TextBox Text="{Binding Similarity, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Mono}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="검색 영역" Style="{StaticResource Text.Label}" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="지정" Command="{Binding DataContext.PickRegionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                <TextBlock Text="{Binding RegionText}" Style="{StaticResource Text.Mono}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="발견하면 그 위치를 클릭" IsChecked="{Binding ClickOnFound}" Margin="0,0,0,12" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsWindowExistsCondition, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Style="{StaticResource Field}">
                                        <TextBlock Text="창 제목에 포함된 문자열" Style="{StaticResource Text.Label}" />
                                        <TextBox Text="{Binding ConditionTitle, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Field}">
                                        <TextBlock Text="프로세스 이름 (예: chrome)" Style="{StaticResource Text.Label}" />
                                        <TextBox Text="{Binding ConditionProcess, UpdateSourceTrigger=LostFocus}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsWindowTitleCondition, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="활성 창 제목에 포함된 문자열" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding ConditionTitle, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>

                                <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsTimeoutCondition, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="매크로 시작 후 경과 시간 (ms)" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                </StackPanel>

                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="재시도 횟수" Style="{StaticResource Text.Label}" />
                                        <TextBox Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="재시도 간격 (ms)" Style="{StaticResource Text.Label}" />
                                        <TextBox Text="{Binding RetryIntervalMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Style="{StaticResource Field}">
                                    <TextBlock Text="조건 실패 시 (ELSE 동작이 없을 때)" Style="{StaticResource Text.Label}" />
                                    <ComboBox ItemsSource="{Binding DataContext.FailurePolicies, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding OnFailure}" />
                                </StackPanel>

                                <views:NestedActionList Header="THEN — 조건이 참일 때" Items="{Binding Children}" AddSlot="then" />
                                <views:NestedActionList Header="ELSE — 조건이 거짓일 때" Items="{Binding ElseChildren}" AddSlot="else" />
                            </StackPanel>

                            <Border Style="{StaticResource Divider}" />

                            <!-- Common: delays -->
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="실행 전 지연 (ms)" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding DelayBeforeMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="실행 후 지연 (ms)" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding DelayAfterMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="랜덤 추가 (최대 ms)" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding RandomDelayMaxMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel>
                                <TextBlock Text="메모" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding Comment, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Screen preview -->
                    <Border Style="{StaticResource Panel.Surface}" Margin="0,0,0,16" Padding="12" Visibility="{Binding SelectedPreviewPoint, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel>
                            <TextBlock Text="화면 미리보기" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,8" />
                            <views:ScreenPreview Point="{Binding SelectedPreviewPoint}" Height="180" />
                        </StackPanel>
                    </Border>

                    <!-- Schedule -->
                    <Border Style="{StaticResource Panel.Surface}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="실행 방식" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />
                            <StackPanel Style="{StaticResource Field}">
                                <ComboBox ItemsSource="{Binding ScheduleTypes}" SelectedItem="{Binding ScheduleType}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding}" Value="Immediate"><Setter Property="Text" Value="즉시 실행" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding}" Value="Once"><Setter Property="Text" Value="예약 실행 (지정 시각)" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding}" Value="Interval"><Setter Property="Text" Value="반복 실행 (간격)" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <Grid Style="{StaticResource Row}" Visibility="{Binding IsOnce, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="날짜" Style="{StaticResource Text.Label}" />
                                    <DatePicker SelectedDate="{Binding ScheduleDate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="시간 (HH:mm:ss.fff)" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding ScheduleTime, UpdateSourceTrigger=LostFocus}" Style="{StaticResource TextBox.Mono}" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}" Visibility="{Binding IsInterval, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="간격 (ms)" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="반복 횟수 (0 = 무한)" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding RepeatCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Target window -->
                    <Border Style="{StaticResource Panel.Surface}" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="지우기" Style="{StaticResource Button.Ghost}" Command="{Binding ClearTargetCommand}" />
                                <Button DockPanel.Dock="Right" Content="새로고침" Style="{StaticResource Button.Ghost}" Command="{Binding RefreshWindowsCommand}" />
                                <TextBlock Text="대상 창" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="열려 있는 창에서 선택" Style="{StaticResource Text.Label}" />
                                <ComboBox x:Name="WindowPicker" ItemsSource="{Binding AvailableWindows}" DisplayMemberPath="Title" SelectionChanged="WindowPicker_SelectionChanged" />
                            </StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="제목 포함" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding TargetTitle, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="프로세스" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding TargetProcess, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="실행 전에 창을 앞으로 가져오기" IsChecked="{Binding BringToFront}" />
                            <TextBlock Text="'창 기준' 좌표를 쓰는 동작은 이 창의 클라이언트 영역을 기준으로 계산됩니다." Style="{StaticResource Text.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Macro settings -->
                    <Border Style="{StaticResource Panel.Surface}">
                        <StackPanel>
                            <TextBlock Text="실행 옵션" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,10" />
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="실패 시 재시도" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding MaxRetries, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="재시도 간격 (ms)" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding RetryIntervalMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="동작 간 기본 지연 (ms)" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding DefaultDelayBetweenActionsMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.Mono}" />
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="오류 발생 시 중단" IsChecked="{Binding StopOnError}" Margin="0,0,0,8" />
                            <CheckBox Content="실행 후 마우스 위치 복원" IsChecked="{Binding RestoreCursorAfterRun}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
